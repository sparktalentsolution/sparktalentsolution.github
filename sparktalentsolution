< index html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Spark Talent Solution — Leading Recruitment Firm</title>
  <meta name="description" content="Premium recruitment services connecting top talent with leading companies across industries." />
  <meta name="theme-color" content="#1e3c72" />

  <!-- Open Graph / Twitter -->
  <meta property="og:title" content="Spark Talent Solution — Leading Recruitment Firm" />
  <meta property="og:description" content="Premium recruitment services connecting top talent with leading companies across industries." />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="canonical" href="https://yourdomain.example/" />

  <!-- Styles -->
  <link rel="stylesheet" href="assets/styles.css" />

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Spark Talent Solution",
    "url": "https://yourdomain.example/",
    "logo": "https://yourdomain.example/logo.png",
    "contactPoint": [{
      "@type": "ContactPoint",
      "telephone": "+91 9423007945",
      "contactType": "customer service",
      "areaServed": "IN",
      "email": "sparktalentsolution@gmail.com"
    }],
    "sameAs": []
  }
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header" role="banner">
    <div class="container header-inner">
      <a class="logo" href="/" aria-label="Spark Talent Solution homepage">Spark Talent Solution</a>

      <button id="nav-toggle" class="nav-toggle" aria-controls="primary-nav" aria-expanded="false" aria-label="Open navigation">
        <span class="hamburger" aria-hidden="true"></span>
      </button>

      <nav id="primary-nav" class="primary-nav" role="navigation" aria-label="Primary">
        <ul>
          <li><a href="#home">Home</a></li>
          <li><a href="#services">Services</a></li>
          <li><a href="#jobs">Jobs</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <section id="home" class="hero" aria-labelledby="hero-heading">
      <div class="container hero-inner">
        <h1 id="hero-heading">Spark Talent Solution</h1>
        <p class="lead">Connecting exceptional talent with extraordinary opportunities.</p>
        <p><a class="btn" href="#jobs">Find Jobs Now</a></p>
      </div>
    </section>

    <section id="services" class="section">
      <div class="container">
        <h2>Our Recruitment Services</h2>
        <div class="grid services-grid" role="list">
          <article class="card" role="listitem">
            <div class="service-icon" aria-hidden="true">👥</div>
            <h3>Executive Search</h3>
            <p>Targeted searches for C-level and senior leadership positions across industries.</p>
          </article>

          <article class="card" role="listitem">
            <div class="service-icon" aria-hidden="true">💼</div>
            <h3>Contract Staffing</h3>
            <p>Flexible staffing solutions for short-term projects and seasonal requirements.</p>
          </article>

          <article class="card" role="listitem">
            <div class="service-icon" aria-hidden="true">🌐</div>
            <h3>Global Talent</h3>
            <p>International recruitment connecting talent across borders and time zones.</p>
          </article>

          <article class="card" role="listitem">
            <div class="service-icon" aria-hidden="true">🎯</div>
            <h3>Specialized Placement</h3>
            <p>Industry-specific recruitment in IT, Healthcare, Finance, and Engineering.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="about" class="section alt-bg">
      <div class="container">
        <h2>Why Choose Us</h2>
        <div class="grid stats-grid" role="list">
          <div class="stat" role="listitem"><strong>500+</strong><span>Placements Last Year</span></div>
          <div class="stat" role="listitem"><strong>98%</strong><span>Client Satisfaction</span></div>
          <div class="stat" role="listitem"><strong>24h</strong><span>Response Time</span></div>
          <div class="stat" role="listitem"><strong>50+</strong><span>Industries Served</span></div>
        </div>
      </div>
    </section>

    <section id="jobs" class="section">
      <div class="container">
        <h2>Featured Positions</h2>

        <article class="job-listing" aria-labelledby="job-1">
          <h3 id="job-1">Senior Software Engineer</h3>
          <p class="meta"><strong>Location:</strong> Bangalore | <strong>Salary:</strong> ₹25-35 LPA | <strong>Type:</strong> Full-time</p>
          <p>Build scalable web applications using React and Node.js. 5+ years experience required.</p>
          <p><a class="btn small" href="#" aria-label="Apply for Senior Software Engineer">Apply Now</a></p>
        </article>

        <article class="job-listing" aria-labelledby="job-2">
          <h3 id="job-2">Marketing Manager</h3>
          <p class="meta"><strong>Location:</strong> Mumbai | <strong>Salary:</strong> ₹18-25 LPA | <strong>Type:</strong> Full-time</p>
          <p>Lead digital marketing strategy for leading FMCG brand. 7+ years experience.</p>
          <p><a class="btn small" href="#" aria-label="Apply for Marketing Manager">Apply Now</a></p>
        </article>

        <article class="job-listing" aria-labelledby="job-3">
          <h3 id="job-3">Data Scientist</h3>
          <p class="meta"><strong>Location:</strong> Pune | <strong>Salary:</strong> ₹22-30 LPA | <strong>Type:</strong> Full-time</p>
          <p>Machine learning expertise with Python, TensorFlow. 4+ years experience.</p>
          <p><a class="btn small" href="#" aria-label="Apply for Data Scientist">Apply Now</a></p>
        </article>
      </div>
    </section>

    <section id="contact" class="section alt-bg">
      <div class="container">
        <h2>Get In Touch</h2>
        <form id="contact-form" class="contact-form" aria-describedby="contact-help" novalidate>
          <p id="contact-help" class="form-note">We respond within 24 hours. All fields with * are required.</p>

          <!-- honeypot for bots -->
          <input type="text" name="website" id="website" class="honeypot" tabindex="-1" autocomplete="off" />

          <div class="form-row">
            <label for="name">Your Name *</label>
            <input id="name" name="name" type="text" required />
          </div>

          <div class="form-row">
            <label for="email">Email *</label>
            <input id="email" name="email" type="email" required />
          </div>

          <div class="form-row">
            <label for="subject">Subject</label>
            <input id="subject" name="subject" type="text" />
          </div>

          <div class="form-row">
            <label for="message">Message *</label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn">Send Message</button>
            <div id="form-status" role="status" aria-live="polite"></div>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="container footer-inner">
      <p>&copy; 2026 Spark Talent Solution. All rights reserved.</p>
      <p>Phone: <a href="tel:+919423007945">+91 9423007945</a> | Email: <a href="mailto:sparktalentsolution@gmail.com">sparktalentsolution@gmail.com</a></p>
    </div>
  </footer>

  <script src="assets/script.js" defer></script>
</body>
</html>
